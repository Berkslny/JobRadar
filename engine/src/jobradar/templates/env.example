# JobRadar secrets. Save this file as .env next to jobradar.yaml and never share it.
# The JobRadar app keeps these values in the macOS Keychain instead; this file is for command line and server use.

# API keys for pay-per-token model providers. Only used when llm.allow_paid_api is true in jobradar.yaml.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: e-mail digest and reading replies (Gmail: a 16-character app password, not your normal password)
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=

# Optional: Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: personal freehire.me API key (works without one)
FREEHIRE_API_KEY=
